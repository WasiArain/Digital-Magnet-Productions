b7-f7b4-4b38-acd7-0e9b80400672","case":"01bc92e1-0f99-4fa2-98b1-5d263ffacc70","component":"case_card","is_narrow":false},{"_uid":"6b113cfc-ccd5-445f-a3f2-49328bbad51a","case":"6e41e04d-2ebd-4448-bc6e-54054692a82e","component":"case_card","is_narrow":false},{"_uid":"16b182fc-013c-4349-8633-8acb2b5427b8","case":"05025fde-e15e-4f62-811e-aac82201c28d","component":"case_card","is_narrow":false},{"_uid":"10ee9cb9-85f0-49c8-b047-69590bbcb1e2","case":"42b5d727-137a-41f9-b9e1-eb135d6ac264","component":"case_card","is_narrow":false},{"_uid":"0bb30356-ecca-4c86-81f9-cb943ce31459","case":"44da6e08-af27-44bc-8dd1-f544707cb135","component":"case_card","is_narrow":false}],"title":"Our Work","is_dark":false,"component":"case_carousel","placeholder_image":[]},{"_uid":"2e3913d0-5677-4674-99a8-b4317affee30","image":{"id":8792837,"alt":"Amsterdam Office Dentsu Creative work station","name":"","focus":"","title":"","filename":"https://a.storyblok.com/f/155984/1920x1080/b6428ddb78/amsterdam-office-dentsu-creative-work-station.png","copyright":"","fieldtype":"asset","is_external_url":false},"caption":"","component":"image_block","layout_size":"full-width","use_accent_color":false},{"_uid":"14818907-37e0-4f11-a4d5-463cb83ae52c","text":{"type":"doc","content":[{"type":"heading","attrs":{"level":4},"content":[{"text":"THE OFFICE","type":"text"}]},{"type":"paragraph","content":[{"text":"The world after Covid has taught us many things about flexible, hybrid work. More than ever, we collaborate with our 9000+  creative colleagues from around the world who are connected to dentsu’s Media and CX experts.","type":"text"}]},{"type":"paragraph","content":[{"text":"Our Amsterdam office is designed based on the principles of hospitality, collaboration and human connection envisioned with OST architects, a company famous for some of Amsterdam’s most popular bars and hotels.","type":"text"}]}]},"image":{"id":8792797,"alt":"Amsterdam Office Dentsu Creative reception","name":"","focus":"","title":"","file