email","fieldtype":"multilink","cached_url":"Dentsu.Creative.US.Comms@dentsu.com"},"email_address":"Dentsu.Creative.US.Comms@dentsu.com"},{"_uid":"20ef2a2b-2d59-4758-b852-d42571d328e8","title":"New Business","component":"email","email_link":{"id":"","url":"Dentsu.Creative.US.NewBiz@dentsu.com","email":"Dentsu.Creative.US.NewBiz@dentsu.com","linktype":"email","fieldtype":"multilink","cached_url":"Dentsu.Creative.US.NewBiz@dentsu.com"},"email_address":"Dentsu.Creative.US.NewBiz@dentsu.com"}],"address":"515 N State Street \n20th Floor\nChicago\nIL 60654","country":"","location":"Chicago","component":"office_contact_info","office_link":[]}],"component":"office_details","description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"We are Dentsu Creative U.S. ","type":"text"},{"type":"hard_break"},{"type":"hard_break"},{"text":"We are made up of two creative hubs located in New York and Chicago.","type":"text"},{"type":"hard_break"},{"type":"hard_break"},{"text":"Our New York hub is amidst midtown’s electrifying energy. A short walk from Grand Central Station, our office building blends international and modern architecture, marrying the city’s rich history with our dymanic present. Our office space features abundant natural light and a modern approach to desks and meeting rooms. The environment is enriched by displays of our work with pioneering brands including TUMS, Burger King, OREO, 7-Eleven and more.","type":"text"},{"type":"hard_break"},{"type":"hard_break"},{"text":"The Chicago hub was designed by world-renowned Japanese Architect Kenzo Tange—one of the first office spaces to utilize power over ethernet lighting to illuminate using a circadian rhythm for employee wellness. We’re located two blocks west of the Magnificent Mile and two blocks North of the city’s sprawling Riverwalk. For us, Transformative Creativity is what separates distinctive from dime-a-dozen in a beyond noisy world. That’s reflected in the caliber of leading brands we serve: Disney, Intel, The Hershey Company, Famous Footwear, Olive Garden and more. Our office houses a full sound stage with editing suits, so we can create collaboratively and move at the speed of culture. The building also has a state-of-the-art fitness center and an urban outdoor plaza.","type":"text"}]}]},"socials_links":[{"_uid":"0f9edea9-dc9b-46ae-a3fc-0b1e25944b0b","link":{"id":"","url":"https://www.instagram.com/DentsuCreativeUS","linktype":"url","fieldtype":"multilink","cached_url":"https://www.instagram.com/DentsuCreativeUS"},"title":"Instagram","component":"ahref_link"},{"_uid":"434c8c65-a3d3-4c14-abcb-0b7b2d422c6e","link":{"id":"","url":"https://www.linkedin.com/showcase/dentsu-creative-us/","linktype":"url","fieldtype":"multilink","cached_url":"https://www.linkedin.com/showcase/dentsu-creative-us/"},"title":"Linkedin","component":"ahref_link"},{"_uid":"4ca64b4a-4192-4867-af97-6a35e00f8b1b","link":{"id":"","url":"https://www.facebook.com/DentsuCreativeUS","linktype":"url","fieldtype":"multilink","cached_url":"https://www.facebook.com/DentsuCreativeUS"},"title":"Facebook","component":"ahref_link"},{"_uid":"6a9f50ab-e9db-40f3-b7c6-8c98128f3c1a","link":{"id":"","url":"https://twitter.com/DentsuCRTVUS","linktype":"url","fieldtype":"multilink","cached_url":"https://twitter.com/DentsuCRTVUS"},"title":"Twitter","component":"ahref_link"}],"socials_title":"Socials"}],"seo_description":"Connect with the future of branding at DENTSU CREATIVE US. Visit our site to learn about our services & how we can help your brand skyrocket.","seo_image_portrait":{"id":null,"alt":null,"name":"","focus":null,"title":null,"filename":"","copyright":null,"fieldtype":"asset"}},"slug":"united-states","full_slug":"location/united-states/","sort_by_date":null,"position":-10,"tag_list":[],"is_startpage":true,"parent_id":203707126,"meta_data":null,"group_id":"41fca9d0-d0a8-4bfa-b3a7-a2f9154d8434","first_published_at":"2022-10-09T15:56:44.960Z","release_id":null,"lang":"default","path":"","alternate