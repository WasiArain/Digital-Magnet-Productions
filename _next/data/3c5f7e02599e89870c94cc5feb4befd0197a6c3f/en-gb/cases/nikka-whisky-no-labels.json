{"pageProps":{"story":{"name":"Nikka Whisky No Labels","created_at":"2025-06-16T15:04:57.021Z","published_at":"2025-06-17T15:57:18.810Z","updated_at":"2025-06-17T15:57:18.826Z","id":688301466,"uuid":"5e6a37dd-d87f-4223-8c78-d6c68f0cbcee","content":{"_uid":"a9af7d85-4805-4329-b71b-f5b2dea94b84","title":"No Labels","video":[{"_uid":"7e6aa884-d837-44cd-954f-7c936bfce6ff","component":"video","vimeo_url":"https://vimeo.com/1093755748/1675a092e8","hosted_video":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"poster_image":{"id":23162501,"alt":"Nikka Whisky amber bottle silhouette with hand reaching towards it","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/1792x1008/ff804e7bd5/nikka-01.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky amber bottle silhouette with hand reaching towards it","title":"","source":"","copyright":""},"is_external_url":false}}],"client":"Nikka Whisky","modules":[{"_uid":"0a74c20f-e75a-43ec-9d1b-2cecd8b55645","quote":"In a whisky market polarized between premium and mass-market products, Nikka Whisky faced the challenge of low domestic awareness despite international acclaim. To reposition the brand and connect with modern Japanese consumers, Dentsu Inc. Tokyo launched a new branding initiative that honored the founder’s vision while breaking free from traditional whisky stereotypes.","credit":"","component":"quote_block","use_accent_color":false},{"_uid":"6dc9cf4c-a526-4611-9ce5-6323e39d0b33","image":{"id":23162504,"alt":"Nikka Whisky blue bottle silhouette with hand","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/1920x1080/ab3ac0282f/nikka-02.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky blue bottle silhouette with hand","title":"","source":"","copyright":""},"is_external_url":false},"caption":"","component":"image_block","layout_size":"full-width","use_accent_color":false,"no_inner_parallax":true},{"_uid":"218fe07d-0ec5-481d-974c-9a15d53800ca","text":{"type":"doc","content":[{"type":"heading","attrs":{"level":6},"content":[{"text":"Challenge ","type":"text"}]},{"type":"heading","attrs":{"level":4},"content":[{"text":"Breaking Through a Polarized Market","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]},{"type":"paragraph","content":[{"text":"Despite its global reputation for premium quality, Nikka Whisky struggled with brand recognition in its home country. The Japanese whisky market, heavily influenced by the popularity of highballs and aggressive advertising by mass-market producers, left little room for nuanced appreciation of authentic whisky. Nikka needed to overcome entrenched perceptions about whisky’s price, origin, and audience, and reintroduce itself to a domestic market largely unaware of its rich heritage.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]}]},"component":"rich_text","use_accent_color":false},{"_uid":"9cfef0a1-9ba6-482b-884e-9eebdb648a76","images":[{"id":23162508,"alt":"Nikka Whisky bottles group silhouettes","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2154x1215/772f1e1fe5/nikka-03.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky bottles group silhouettes","title":"","source":"","copyright":""}},{"id":23162506,"alt":"Nikka Whisky book interior pages","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/1744x1744/ceeed7e66e/nikka-04.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky book interior pages","title":"","source":"","copyright":""}},{"id":23162502,"alt":"Nikka Whisky product shot silhouette","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2157x1218/8bc614899d/nikka-05.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky product shot silhouette","title":"","source":"","copyright":""}}],"component":"image_grid_fluid","use_accent_color":false,"no_inner_parallax":true},{"_uid":"7ef26c26-79c5-43a6-afa2-dff98c698d98","text":{"type":"doc","content":[{"type":"heading","attrs":{"level":6},"content":[{"text":"Approach ","type":"text"}]},{"type":"heading","attrs":{"level":4},"content":[{"text":"A Spirit That Celebrates Life","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]},{"type":"paragraph","content":[{"text":"The creative strategy centered on the founder’s belief that whisky is more than a drink — it’s a spirit that inspires joy and connection. The campaign removed all labels, both literal and metaphorical, from the product and its consumers. Through striking photography and visual storytelling using silhouettes, the brand conveyed a message of inclusivity and emotional resonance. This was supported by a suite of assets including print and OOH ads, a brand book, promotional items, videos, and the concept for a flagship bar and shop in Tokyo.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]}]},"component":"rich_text","use_accent_color":false},{"_uid":"cb1e0077-237d-41dc-ae26-348a96e75a80","title":"","assets":[{"id":23162503,"alt":"Nikka Whisky bar bottles on shelves","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2468x1720/aa2902f1c0/nikka-06.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky bar bottles on shelves","title":"","source":"","copyright":""}},{"id":23162499,"alt":"Nikka Whisky packaging","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2469x1720/0e5dbe634b/nikka-07.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky packaging","title":"","source":"","copyright":""}},{"id":23162507,"alt":"Nikka Whisky book covers","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2468x1720/4d1cb00db3/nikka-08.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky book covers","title":"","source":"","copyright":""}}],"component":"slider_content","use_accent_color":false,"no_inner_parallax":true},{"_uid":"ce93afed-f994-40f8-8606-5712fec90d0c","text":{"type":"doc","content":[{"type":"heading","attrs":{"level":6},"content":[{"text":"Solution ","type":"text"}]},{"type":"heading","attrs":{"level":4},"content":[{"text":"Illuminating Whisky’s True Essence","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]},{"type":"paragraph","content":[{"text":"The campaign’s visual language used unlabeled bottles and projected light to create dynamic silhouettes, symbolizing the evolving perception of whisky. These visuals captured the vibrant color of the whisky and the fluidity of life, without relying on faces or product names. High-intensity projectors also cast expressive human silhouettes, reinforcing the theme of joy and freedom. This artistic, label-free approach allowed Nikka to transcend traditional whisky marketing and connect with a broader, more diverse audience.","type":"text","marks":[{"type":"textStyle","attrs":{"color":"#000000"}}]}]}]},"component":"rich_text","use_accent_color":false},{"_uid":"f86402c6-758c-4eb9-9423-16dca8183d56","image":{"id":23162505,"alt":"Grid of Nikka Whisky campaign images","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2972x1672/30a8ba87dd/nikka-09.jpg","copyright":"","fieldtype":"asset","meta_data":{"alt":"Grid of Nikka Whisky campaign images","title":"","source":"","copyright":""},"is_external_url":false},"caption":"","component":"image_block","layout_size":"large","use_accent_color":false,"no_inner_parallax":true},{"_uid":"58fe0205-be12-4a61-a2ef-6741f9932228","image":{"id":23162500,"alt":"Nikka Whisky bottle silhouette with hand","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2972x1672/7dfdf1bc96/nikka-10.png","copyright":"","fieldtype":"asset","meta_data":{"alt":"Nikka Whisky bottle silhouette with hand","title":"","source":"","copyright":""},"is_external_url":false},"caption":"","component":"image_block","layout_size":"small","use_accent_color":false,"no_inner_parallax":true},{"_uid":"718c68d7-3835-454f-b307-672d09e5f8e0","values":[{"_uid":"64c95771-ce1a-42b9-9cc0-a5a7d29eaf2b","number":"45","component":"statistic","unit_left":"","unit_right":"%","description":"Increase in domestic brand recognition within 6 months of launch."},{"_uid":"209d0185-9f20-454e-8820-5d493674ba5a","number":"30","component":"statistic","unit_left":"","unit_right":"%","description":"Growth in foot traffic to new Tokyo flagship bar and shop."},{"_uid":"0e093a3f-f3a5-4c87-b5e0-e59b5b6a2565","number":"10","component":"statistic","unit_left":"+","unit_right":"M","description":"Impressions across print, OOH, and digital media."},{"_uid":"83868824-1ef9-4a29-b671-f87aae723989","number":"38","component":"statistic","unit_left":"","unit_right":"%","description":"Increase in brand favorability among target demographics."}],"component":"statistics","use_accent_color":false}],"category":["Creates Culture"],"component":"case","countries":[],"key_image":[{"_uid":"bd7e31c5-312e-448d-bb92-e36bd1843c4a","alt_text":"","component":"responsive_image","image_caption":"","animated_image":{"id":null,"alt":null,"name":"","focus":null,"title":null,"source":null,"filename":"","copyright":null,"fieldtype":"asset","meta_data":{}},"image_portrait":"https://a.storyblok.com/f/155984/2972x1672/7dfdf1bc96/nikka-10.png","image_landscape":"https://a.storyblok.com/f/155984/1792x1008/ff804e7bd5/nikka-01.jpg"}],"locations":[{"name":"Japan","created_at":"2024-04-25T14:59:13.583Z","published_at":"2026-03-27T12:12:41.021Z","updated_at":"2026-03-27T12:12:41.035Z","id":485004737,"uuid":"a1a288df-75ec-405a-9e6c-35eeb17d99aa","content":{"_uid":"7ddf678f-3b2c-49a8-a704-3ac90945936b","city":"São Paulo","title":"Tokyo