{"pageProps":{"story":{"name":"CHRIS CHEN​","created_at":"2023-10-24T11:55:53.894Z","published_at":"2026-06-23T10:48:06.369Z","updated_at":"2026-06-23T10:48:06.383Z","id":394231828,"uuid":"278cd441-3c49-49ad-96f3-a7c6b860f0a2","content":{"_uid":"96e88955-4d71-4811-bff5-7997eee17f38","sections":[],"component":"person_overview","seo_image":{"id":4985854,"alt":"DENTSU CREATIVE logo landscape","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/1792x1008/aa482dcc07/placeholder_landscape.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"seo_title":"Dentsu Creative Leaders | Chris Chen | CCO, Dentsu Creative China","label_back_to":"Back","person_details":[{"_uid":"98f92d46-c808-4f3d-8747-c4e5b7c57410","name":"CHRIS CHEN​","title":"Managing Director","contact":[{"_uid":"b920ca01-38bd-4f78-a8e4-bbb3d7d55738","label":"Location","emails":[],"location":{"id":"89f860da-09e7-404b-9b39-19a0f1b4c8d6","url":"","linktype":"story","fieldtype":"multilink","cached_url":"/en-gb/location/china/","prep":true,"story":{"name":"China","id":203707177,"uuid":"89f860da-09e7-404b-9b39-19a0f1b4c8d6","slug":"china","url":"location/china/","full_slug":"en-gb/location/china/","_stopResolving":true}},"component":"person_contact_info"}],"offices":[{"_uid":"0ee4d502-fd95-4271-913b-d12c31779331","city":"London","emails":[{"_uid":"a5a8c6f1-498d-41b5-8232-73ad7bbbcf98","title":"General","component":"email","email_link":{"id":"","url":"boris.nihom@dentsu.com","email":"boris.nihom@dentsu.com","linktype":"email","fieldtype":"multilink","cached_url":"boris.nihom@dentsu.com"},"email_address":"boris.nihom@dentsu.com"}],"address":"Moermanskkade 89\n1013 BC Amsterdam\nThe Netherlands","country":"","location":"Amsterdam","component":"office_contact_info","office_link":[]}],"portrait":{"id":190554437190150,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a.storyblok.com/f/155984/2256x2560/6fa8648fc6/6-chris-chen.jpg","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"pronouns":"He/Him","component":"person_details","job_title":"CCO, DENTSU CREATIVE CHINA​","description":{"type":"doc","content":[{"type":"paragraph","content":[{"text":"As Chief Creative Officer, Chris is responsible for leading and integrating the creative teams in dentsu China Creative Service Line. He is tasked with delivering superior quality work, developing new creative products, and offerings, and supporting the agency's creative culture beyond day-to-day client engagements. He also supports and promotes the agency brand and sets the tone for its creative philosophy and excellency. ​","type":"text"}]},{"type":"paragraph","content":[{"text":"Chris is the winner of Campaign Greater China’s Creative Person of the Year 2019 and Greater China Agency Head of the Year 2016. Chris and his team have won more than 150 awards across the world, Asia, and China, including Cannes Gold Lion, LIA, gold in Spikes Asia, Digital Creative/Media Agency of the Year at ROI Festival, and Greater China Most Effective Agency Network of the Year at Effie. He has served on the jury of prestigious awards such as the Cannes Lions Festival, the New York Ad Festival, Spikes Asia, and D&AD.​","type":"text"}]}]},"socials_links":[{"_uid":"3220ad96-b6c3-49d5-b18c-1ab7e900e654","link":{"id":"","url":"https://www.linkedin.com/in/chris-chen-99b76331/","target":"_blank","linktype":"url","fieldtype":"multilink","cached_url":"https://www.linkedin.com/in/chris-chen-99b76331/"},"title":"LINKEDIN","component":"ahref_link"}],"socials_title":"Socials","label_function":"Function","use_accent_color":false}],"seo_description":"Chris Chen, Chief Creative Officer at dentsu China, leads integrated creative teams, delivers superior work, and supports agency brand and culture. Winner of multiple prestigious awards.","seo_image_portrait":{"id":7688751,"alt":"CHRIS CHEN DENTSU CREATIVE","name":"","focus":"","title":"","source":"","filename":"https